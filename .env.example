# ── News source ──────────────────────────────────────────────────────────────
NEWSAPI_KEY=your_newsapi_key_here

# ── LLM backend ──────────────────────────────────────────────────────────────
# Use "ollama" for free local generation (recommended)
# Use "openai" for cloud generation (requires OPENAI_API_KEY)
LLM_BACKEND=ollama

# Ollama settings (only used when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# OpenAI settings (only used when LLM_BACKEND=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ── Tunable parameters ────────────────────────────────────────────────────────
NEWS_MAX_AGE_HOURS=48
NEWS_MIN_SOURCES=2

# ── Facebook Publishing (Phase 3) ─────────────────────────────────────────────
# Only needed when running: python agent.py --publish
FACEBOOK_PAGE_ID=your_page_id_here
FACEBOOK_PAGE_TOKEN=your_page_access_token_here
# Keep this on a currently supported Meta Graph API version.
FACEBOOK_GRAPH_API_VERSION=v25.0
