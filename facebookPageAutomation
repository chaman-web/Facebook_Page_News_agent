nal_quality (0–5)\n   Is the card clean, polished, and error-free?\n   5 = no visible layout issues, no overflow, no clutter.\n   Deduct for any layout errors detected in the pixel or mobile analysis.\n\n━━━ OUTPUT FORMAT ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nRespond ONLY with valid JSON. No markdown. No text outside the JSON.\n\n{{\n  \"reasoning\": {{\n    \"headline_clarity\":     \"<Step 1: one specific observation> → score: N\",\n    \"visual_impact\":        \"<Step 1: one specific observation> → score: N\",\n    \"story_importance\":     \"<Step 1: one specific observation> → score: N\",\n    \"mobile_readability\":   \"<Step 1: one specific observation> → score: N\",\n    \"emotional_interest\":   \"<Step 1: one specific observation> → score: N\",\n    \"brand_consistency\":    \"<Step 1: one specific observation> → score: N\",\n    \"professional_quality\": \"<Step 1: one specific observation> → score: N\"\n  }},\n  \"headline_clarity\":     <int 0-20>,\n  \"visual_impact\":        <int 0-20>,\n  \"story_importance\":     <int 0-20>,\n  \"mobile_readability\":   <int 0-15>,\n  \"emotional_interest\":   <int 0-10>,\n  \"brand_consistency\":    <int 0-10>,\n  \"professional_quality\": <int 0-5>,\n  \"notes\": \"<one-line overall summary of the card's main strength and weakness>\"\n}}\n\"\"\"\n\n\n# ── Ollama call ───────────────────────────────────────────────────────────────\n\ndef _call_ollama(prompt: str) -> str:\n    base_url = (config.OLLAMA_BASE_URL or \"http://localhost:11434/v1\").rstrip(\"/\")\n    model    = config.OLLAMA_MODEL or \"llama3.2\"\n\n    payload = {\n        \"model\":    model,\n        \"messages\": [{\"role\": \"user\", \"content\": prompt}],\n        \"stream\":   False,\n        \"options\":  {\n            \"temperature\": 0.15,  # very low — consistent evaluative scoring\n            \"top_p\":       0.9,\n            \"num_predict\": 800,   # enough for reasoning + scores\n        },\n    }\n\n    r = requests.post(f\"{base_