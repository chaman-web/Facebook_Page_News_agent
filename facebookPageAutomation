ry,\n    image_path: Optional[Path],\n    mobile_issues: Optional[dict],\n    card_facts: dict,\n) -> str:\n    headline  = story.title\n    category  = (story.category or \"news\").upper()\n    source    = story.source_name or \"Unknown\"\n    summary   = (story.raw_summary or \"\")[:300]\n    has_image = image_path is not None and image_path.exists()\n    word_count = len(headline.split())\n\n    # Mobile issues section\n    if mobile_issues:\n        mobile_section = (\n            \"MOBILE CHECKS: The following automated pixel checks FAILED:\\n\"\n            + \"\\n\".join(f\"  ✗ {k}: {v}\" for k, v in mobile_issues.items())\n        )\n    else:\n        mobile_section = \"MOBILE CHECKS: All automated pixel checks PASSED ✓\"\n\n    # Visual card facts section (Improvement 1)\n    if card_facts:\n        facts_section = \"CARD PIXEL ANALYSIS (measured from the actual composed image):\\n\" + \\\n            \"\\n\".join(f\"  • {v}\" for v in card_facts.values())\n    else:\n        facts_section = \"CARD PIXEL ANALYSIS: No image available (text-only post).\"\n\n    no_image_penalty = \"\" if has_image else \"\\n⚠ No image — deduct 8–12 points from Visual Impact automatically.\"\n\n    return f\"\"\"You are a senior social media editor at \"Global Pulse News\", a professional Facebook news page.\n\nScore this Facebook news card BEFORE publishing. This is an INTERNAL quality gate.\nScore it as a real human thumb-scrolling their phone feed would experience it.\nBe HONEST. Do NOT inflate scores. A score of 20/20 means near-perfect execution.\n\n━━━ POST DETAILS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nHEADLINE   : {headline}\nWORD COUNT : {word_count} words\nCATEGORY   : {category}\nSOURCE     : {source}\nSUMMARY    : {summary}\nIMAGE      : {\"Composed card image exists\" if has_image else \"NO IMAGE — text-only post\"}{no_image_penalty}\n\n━━━ AUTOMATED CHECKS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n{mobile_section}\n\n━━━ VISUAL CARD DATA (real pixel measurements)