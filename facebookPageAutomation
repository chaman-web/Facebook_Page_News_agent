                    "Text": "    \"\"\"Result of the attention score evaluation.\"\"\"\n    headline_clarity:    int   # /20\n    visual_impact:       int   # /20\n    story_importance:    int   # /20\n    mobile_readability:  int   # /15\n    emotional_interest:  int   # /10\n    brand_consistency:   int   # /10\n    professional_quality: int  # /5\n    total:               int   # /100\n    verdict:             str   # PUBLISH | PUBLISH_IF_HIGH | IMPROVE | REGENERATE\n    notes:               str   # LLM's brief rationale (one sentence per criterion)\n    raw_response:        str   # full LLM reply for debugging\n\n    def scorecard(self) -> str:\n        \"\"\"Return a formatted scorecard string for logging.\"\"\"\n        bar_width = 30\n        lines = [\n            \"┌─ ATTENTION SCORE ──────────────────────────────────┐\",\n            f\"│  Headline clarity       {self.headline_clarity:>3}/20  {'█' * int(self.headline_clarity / 20 * bar_width // 3):<10}│\",\n            f\"│  Visual impact          {self.visual_impact:>3}/20  {'█' * int(self.visual_impact / 20 * bar_width // 3):<10}│\",\n            f\"│  Story importance       {self.story_importance:>3}/20  {'█' * int(self.story_importance / 20 * bar_width // 3):<10}│\",\n            f\"│  Mobile readability     {self.mobile_readability:>3}/15  {'█' * int(self.mobile_readability / 15 * bar_width // 3):<10}│\",\n            f\"│  Emotional interest     {self.emotional_interest:>3}/10  {'█' * int(self.emotional_interest / 10 * bar_width // 3):<10}│\",\n            f\"│  Brand consistency      {self.brand_consistency:>3}/10  {'█' * int(self.brand_consistency / 10 * bar_width // 3):<10}│\",\n            f\"│  Professional quality   {self.professional_quality:>3}/5   {'█' * int(self.professional_quality / 5 * bar_width // 3):<10}│\",\n            f\"│  {'─' * 48}│\",\n            f\"│  TOTAL                  {self.total:>3}/100                   │\",\n            f\"│  VERDICT: {self.verdict:<40}│\",\n            \"└────────────────────────────────────────────────────┘\",\n        ]\n        if self.notes:\n            lines.append(f\"  Notes: {self.notes[:120]}\")\n        return \"\\n\".join(lines)\n\n\ndef score_attention(\n    story: Story,\n    image_path: Optional[Path] = None,\n    mobile_issues: Optional[dict] = None,\n) -> AttentionResult:\n    \"\"\"\n    Ask Ollama to score the card and return an AttentionResult.\n\n    Parameters\n    ----------\n    story         : the Story being evaluated\n    image_path    : path to the composed card image (used in prompt context)\n    mobile_issues : dict of mobile visibility check failures (from maker.py)\n                    passed as context so LLM can factor them into the score\n\n    Falls back to a rule-based heuristic score if Ollama is unavailable.\n    \"\"\"\n    prompt = _build_prompt(story, image_path, mobile_issues)\n\n    try:\n        result = _call_ollama(prompt)\n        return _parse_response(result, story)\n    except Exception as exc:\n        logger.warning(\"Attention score LLM call failed (%s) — using heuristic fallback\", exc)\n        return _heuristic_score(story, mobile_issues)\n\n\n# ── Prompt builder ────────────────────────────────────────────────────────────\n\ndef _build_prompt(\n    story: Story,\n    image_path: Optional[Path],\n    mobile_issues: Optional[dict],\n) -> str:\n    headline  = story.title\n    category  = (story.category or \"news\").upper()\n    source    = story.source_name or \"Unknown\"\n    summary   = (story.raw_summary or \"\")[:300]\n    has_image = image_path is not None and image_path.exists()\n\n    mobile_note = \"\"\n    if mobile_issues:\n        mobile_note = (\n            \"\\nNote: The following mobile visibility issues were detected by automated checks:\\n\"\n            + \"\\n\".join(f\"  - {k}: {v}\" for k, v in mobile_issues.items())\n            + \"\\nFactor these into Mobile Readability and Visual Impact scores.\\n\"\n        )\n    elif has_image:\n        mobile_note = \"\\nNote: All automated mobile visibility checks passed.\\n\"\n\n    return f\"\"\"You are a senior social media editor for \"Global Pulse News\", a professional news page on Facebook.\n\nYour job is to score a Facebook news post card BEFORE it is published.\nThis is an internal quality-control score — NOT Facebook's algorithm score.\nScore how a real human scrolling their phone feed would react to this card.\n\n─── POST DETAILS ───────────────────────────────────────────\nHEADLINE:  {headline}\nCATEGORY:  {category}\nSOURCE:    {source}\nSUMMARY:   {summary}\nIMAGE:     {\"Card image exists\" if has_image else \"No image (text-only post)\"}\n{mobile_note}\n─── SCORING CRITERIA ───────────────────────────────────────\nScore each criterion honestly. Do not inflate scores.\n\n1. Headline clarity       (0–20): Is the headline sharp, specific, and scannable?\n   A score of 20 means anyone reads it and instantly knows exactly what happened.\n   Deduct for vague language, jargon, missing subject, or ambiguity.\n\n2. Visual impact          (0–20): Would this card stop a thumb while scrolling?\n   A score of 20 means the card is visually striking with a compelling photo.\n   Deduct for no image, blurry photo, poor contrast, or boring composition.\n   {\"Deduct heavily — no image.\" if not has_image else \"\"}\n\n3. Story importance       (0–20): Does this story matter to a general audience?\n   A score of 20 means millions of people would want to know this right now.\n   Deduct for niche topics, minor local stories, or low-stakes content.\n\n4. Mobile readability     (0–15): Readable on a phone within 1–2 seconds?\n   A score of 15 means the headline is large, clear, and immediately legible.\n   Deduct for too many words, small text, or cluttered layout.\n\n5. Emotional interest     (0–10): Does this post create curiosity, urgency, or empathy?\n   A score of 10 means a reader feels compelled to tap or share.\n   Deduct for dry, flat, or overly technical framing.\n\n6. Brand consistency      (0–10): Does this look like Global Pulse News?\n   A score of 10 means navy+white+red palette, professional badge, clean footer.\n   Deduct for anything that looks generic, off-brand, or amateurish.\n\n7. Professional quality   (0–5): Is the overall card clean and error-free?\n   A score of 5 means no visible clutter, overflow, or layout issues.\n   Deduct for any obvious visual errors or text overflow.\n\n─── OUTPUT FORMAT ───────────────────────────────────────────\nRespond ONLY with valid JSON. No markdown, no explanation outside the JSON.\n\n{{\n  \"headline_clarity\":    <int 0-20>,\n  \"visual_impact\":       <int 0-20>,\n  \"story_importance\":    <int 0-20>,\n  \"mobile_readability\":  <int 0-15>,\n  \"emotional_interest\":  <int 0-10>,\n  \"brand_consistency\":   <int 0-10>,\n  \"professional_quality\": <int 0-5>,\n  \"notes\": \"<one sentence per criterion, separated by | >\"\n}}\n\"\"\"\n\n\n# ── Ollama call ───────────────────────────────────────────────────────────────\n\ndef _call_ollama(prompt: str) -> str:\n    \"\"\"Call Ollama chat completions and return the raw text response.\"\"\"\n    base_url = (config.OLLAMA_BASE_URL or \"http://localhost:11434/v1\").rstrip(\"/\")\n    model    = config.OLLAMA_MODEL or \"llama3.2\"\n\n    payload = {\n        \"model\":    model,\n        \"messages\": [{\"role\": \"user\", \"content\": prompt}],\n        \"stream\":   False,\n        \"options\":  {\n            \"temperature\": 0.2,   # low temperature = consistent, non-creative scoring\n            \"top_p\": 0.9,\n        },\n    }\n\n    r = requests.post(\n        f\"{base_url}/chat/completions\",\n        json=payload,\n        timeout=45,\n    )\n    r.raise_for_status()\n    data = r.json()\n    return data[\"choices\"][0][\"message\"][\"content\"].strip()\n\n\n# ── Response parser ───────────────────────────────────────────────────────────\n\ndef _parse_response(raw: str, story: Story) -> AttentionResult:\n    \"\"\"\n    Parse the LLM JSON response into an AttentionResult.\n    Handles common LLM formatting quirks (markdown fences, trailing commas).\n    \"\"\"\n    # Strip markdown code fences if present\n    text = re.sub(r\"```(?:json)?\", \"\", raw).strip()\n    # Remove trailing commas before } or ] (common LLM mistake)\n    text = re.sub(r\",\\s*([}\\]])\", r\"\\1\", text)\n\n    # Extract first JSON object\n    match = re.search(r\"\\{.*\\}\", text, re.DOTALL)\n    if not match:\n        raise ValueError(f\"No JSON found in LLM response: {raw[:200]}\")\n\n    data = json.loads(match.group())\n\n    def clamp(val, lo, hi):\n        return max(lo, min(hi, int(val)))\n\n    hc  = clamp(data.get(\"headline_clarity\",    0),  0, 20)\n    vi  = clamp(data.get(\"visual_impact\",        0),  0, 20)\n    si  = clamp(data.get(\"story_importance\",     0),  0, 20)\n    mr  = clamp(data.get(\"mobile_readability\",   0),  0, 15)\n    ei  = clamp(data.get(\"emotional_interest\",   0),  0, 10)\n    bc  = clamp(data.get(\"brand_consistency\",    0),  0, 10)\n    pq  = clamp(data.get(\"professional_quality\", 0),  0,  5)\n    notes = str(data.get(\"notes\", \"\"))[:300]\n\n    total   = hc + vi + si + mr + ei + bc + pq\n    verdict = _verdict(total, story)\n\n    return AttentionResult(\n        headline_clarity    = hc,\n        visual_impact       = vi,\n        story_importance    = si,\n        mobile_readability  = mr,\n        emotional_interest  = ei,\n        brand_consistency   = bc,\n        professional_quality= pq,\n        total               = total,\n        verdict             = verdict,\n        notes               = notes,\n        raw_response        = raw,\n    )\n\n\n# ── Heuristic fallback ────────────────────────────────────────────────────────\n\ndef _heuristic_score(\n    story: Story,\n    mobile_issues: Optional[dict],\n) -> AttentionResult:\n    \"\"\"\n    Rule-based fallback when Ollama is unavailable.\n    Conservative — never inflates scores beyond what evidence supports.\n    \"\"\"\n    headline = story.title or \"\"\n    words    = len(headline.split())\n    category = (story.category or \"news\").lower()\n\n    # Headline clarity: penalise very long or very short headlines\n    hc = 14\n    if words <= 6:\n        hc = 16\n    elif words <= 10:\n        hc = 14\n    elif words <= 14:\n        hc = 11\n    else:\n        hc = 8\n\n    # Visual impact: penalise if mobile issues present\n    issue_count = len(mobile_issues) if mobile_issues else 0\n    vi = max(8, 16 - issue_count * 3)\n\n    # Story importance: breaking/war/politics score higher\n    high_impact = {\"breaking\", \"war\", \"politics\", \"crime\", \"world\"}\n    si = 16 if category in high_impact else 12\n\n    # Mobile readability: penalise mobile issues\n    mr = max(5, 13 - issue_count * 2)\n\n    # Emotional interest: based on category\n    emotional = {\"breaking\", \"war\", \"crime\", \"trending\", \"entertainment\"}\n    ei = 7 if category in emotional else 5\n\n    # Brand consistency: always moderate (we can't verify visually)\n    bc = 7\n\n    # Professional quality: penalise mobile issues\n    pq = max(2, 5 - issue_count)\n\n    total   = hc + vi + si + mr + ei + bc + pq\n    verdict = _verdict(total, story)\n"
