                    "Text": "\"\"\"\nnews/fetcher.py — Fetch recent worldwide news stories.\n\nPrimary source: NewsAPI top-headlines\nFallback:       RSS feeds via feedparser\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom datetime import datetime, timezone\n\nimport feedparser\nimport requests\n\nimport config\nfrom models import NewsSourceError, Story\n\nlogger = logging.getLogger(__name__)\n\n\n# ---------------------------------------------------------------------------\n# Primary: NewsAPI\n# ---------------------------------------------------------------------------\n\ndef fetch_news() -> list[Story]:\n    \"\"\"\n    Fetch up to 20 recent worldwide news stories.\n    Tries NewsAPI first; falls back to RSS if NewsAPI fails or returns nothing.\n\n    Returns a list of Story objects sorted by published_at descending.\n    Raises NewsSourceError if all sources fail.\n    \"\"\"\n    stories: list[Story] = []\n\n    try:\n        stories = _fetch_from_newsapi()\n        logger.info(\"NewsAPI returned %d stories.\", len(stories))\n    except NewsSourceError as exc:\n        logger.warning(\"NewsAPI failed (%s). Trying RSS fallback.\", exc)\n\n    if not stories:\n        stories = _fetch_from_rss()\n        logger.info(\"RSS fallback returned %d stories.\", len(stories))\n\n    if not stories:\n        raise NewsSourceError(\"No stories retrieved from any source.\")\n\n    # Sort newest first\n    stories.sort(key=lambda s: s.published_at, reverse=True)\n    return stories\n\n\ndef _fetch_from_newsapi() -> list[Story]:\n    \"\"\"Call NewsAPI /v2/top-headlines and return a list of Story objects.\"\"\"\n    params = {\n        \"language\": \"en\",\n        \"pageSize\": 20,\n        \"apiKey\": config.NEWSAPI_KEY,\n    }\n\n    try:\n        response = requests.get(\n            config.NEWSAPI_TOP_HEADLINES_URL,\n            params=params,\n            timeout=10,\n        )\n        response.raise_for_status()\n    except requests.RequestException as exc:\n        raise NewsSourceError(f\"NewsAPI request failed: {exc}\") from exc\n\n    data = response.json()\n\n    if data.get(\"status\") != \"ok\":\n        raise NewsSourceError(\n            f\"NewsAPI returned error: {data.get('message', 'unknown error')}\"\n        )\n\n    stories = []\n    for article in data.get(\"articles\", []):\n        story = _article_to_story(article)\n        if story:\n            stories.append(story)\n\n    return stories\n\n\ndef _article_to_story(article: dict) -> Story | None:\n    \"\"\"Convert a NewsAPI article dict to a Story. Returns None if the article is unusable.\"\"\"\n    title = (article.get(\"title\") or \"\").strip()\n    url = (article.get(\"url\") or \"\").strip()\n\n    # Skip placeholder / removed articles\n    if not title or not url or \"[Removed]\" in title:\n        return None\n\n    source = article.get(\"source\") or {}\n    source_name = (source.get(\"name\") or \"Unknown\").strip()\n\n    raw_summary = (\n        article.get(\"description\") or article.get(\"content\") or \"\"\n    ).strip()\n\n    # Parse publication time; fall back to now if missing/invalid\n    published_at = _parse_datetime(article.get(\"publishedAt\"))\n\n    return Story(\n        title=title,\n        source_name=source_name,\n        source_url=url,\n        published_at=published_at,\n        raw_summary=raw_summary,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Fallback: RSS\n# ---------------------------------------------------------------------------\n\ndef _fetch_from_rss() -> list[Story]:\n    \"\"\"Try each configured RSS feed and return stories from the first that succeeds.\"\"\"\n    for feed_url in config.RSS_FALLBACK_FEEDS:\n        try:\n            stories = _parse_rss_feed(feed_url)\n            if stories:\n                logger.info(\"RSS feed '%s' returned %d stories.\", feed_url, len(stories))\n                return stories\n        except Exception as exc:  # noqa: BLE001\n            logger.warning(\"RSS feed '%s' failed: %s\", feed_url, exc)\n\n    return []\n\n\ndef _parse_rss_feed(feed_url: str) -> list[Story]:\n    \"\"\"Parse an RSS feed and return Story objects.\"\"\"\n    feed = feedparser.parse(feed_url)\n\n    stories = []\n    for entry in feed.entries:\n        title = (getattr(entry, \"title\", \"\") or \"\").strip()\n        url = (getattr(entry, \"link\", \"\") or \"\").strip()\n\n        if not title or not url:\n            continue\n\n        raw_summary = (getattr(entry, \"summary\", \"\") or \"\").strip()\n\n        # feedparser exposes published_parsed as a time.struct_time\n        published_at = datetime.now(timezone.utc)\n        if hasattr(entry, \"published_parsed\") and entry.published_parsed:\n            try:\n                published_at = datetime(*entry.published_parsed[:6], tzinfo=timezone.utc)\n            except (TypeError, ValueError):\n                pass\n\n        # RSS feeds don't always name the source; derive from feed title\n        source_name = (\n            getattr(feed.feed, \"title\", None) or feed_url.split(\"/\")[2]\n        ).strip()\n\n        stories.append(\n            Story(\n                title=title,\n                source_name=source_name,\n                source_url=url,\n                published_at=published_at,\n                raw_summary=raw_summary,\n            )\n        )\n\n    return stories\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef _parse_datetime(value: str | None) -> datetime:\n    \"\"\"Parse an ISO 8601 datetime string. Falls back to UTC now.\"\"\"\n    if not value:\n        return datetime.now(timezone.utc)\n    try:\n        # Python 3.11+ handles 'Z' suffix natively\n        return datetime.fromisoformat(value.replace(\"Z\", \"+00:00\"))\n    except (ValueError, AttributeError):\n        return datetime.now(timezone.utc)"
