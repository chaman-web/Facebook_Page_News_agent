                "file_text": "\"\"\"\nimage/attention_score.py — Pre-publish Human Attention Score\n\nScores a composed news card on 7 editorial criteria using the local Ollama LLM.\nThis is an internal quality-control gate, NOT Facebook's algorithm score.\n\nThree improvements over naive LLM scoring:\n  1. VISUAL CONTEXT INJECTION — pixel-level card analysis fed into the prompt so\n     the text-only LLM scores against real card data, not guesses.\n  2. CHAIN-OF-THOUGHT REASONING — LLM must justify each score with one specific\n     observation before writing the number. Prevents lazy score clustering.\n  3. SCORE LOG — every result written to score_log.jsonl for future correlation\n     with Facebook Insights (reach, engagement) when analytics come in Phase 7.\n\nScore breakdown:\n  Headline clarity       /20   — sharp, specific, scannable?\n  Visual impact          /20   — stops a thumb while scrolling?\n  Story importance       /20   — matters to a general audience right now?\n  Mobile readability     /15   — readable on phone in 1–2 seconds?\n  Emotional interest     /10   — curiosity, urgency, empathy hook?\n  Brand consistency      /10   — unmistakably Global Pulse News?\n  Professional quality    /5   — clean layout, no errors?\n  ─────────────────────────────\n  TOTAL                  /100\n\nVerdict thresholds:\n  90–100 → PUBLISH\n  80–89  → PUBLISH if story priority is high (Tier 1 / breaking)\n  70–79  → IMPROVE (redesign attempted — stronger gradients or new photo)\n  <70    → REGENERATE (skip this story entirely)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport logging\nimport re\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport numpy as np\nimport requests\n\nimport config\nfrom models import Story\n\nlogger = logging.getLogger(__name__)\n\n# ── Score thresholds ──────────────────────────────────────────────────────────\nTHRESHOLD_PUBLISH         = 90\nTHRESHOLD_PUBLISH_IF_HIGH = 80   # only publish if Tier 1 or breaking\nTHRESHOLD_IMPROVE         = 70   # attempt redesign before giving up\n# < THRESHOLD_IMPROVE       → regenerate (skip story)\n\n# ── Score log path ────────────────────────────────────────────────────────────\nSCORE_LOG_PATH = Path(\"score_log.jsonl\")\n\n\n# ── Result dataclass ──────────────────────────────────────────────────────────\n\n@dataclass\nclass AttentionResult:\n    headline_clarity:     int   # /20\n    visual_impact:        int   # /20\n    story_importance:     int   # /20\n    mobile_readability:   int   # /15\n    emotional_interest:   int   # /10\n    brand_consistency:    int   # /10\n    professional_quality: int   # /5\n    total:                int   # /100\n    verdict:              str   # PUBLISH | PUBLISH_IF_HIGH | IMPROVE | REGENERATE\n    reasoning:            dict  = field(default_factory=dict)   # per-criterion justification\n    notes:                str   = \"\"    # compact summary from LLM\n    raw_response:         str   = \"\"    # full LLM reply for debugging\n    scored_by:            str   = \"llm\" # \"llm\" | \"heuristic\"\n\n    def scorecard(self) -> str:\n        \"\"\"Formatted scorecard for logging — shows bars, reasoning, verdict.\"\"\"\n        def bar(val, max_val, width=20):\n            filled = int(val / max_val * width)\n            return \"█\" * filled + \"░\" * (width - filled)\n\n        lines = [\n            \"\",\n            \"  ┌─ ATTENTION SCORE (\" + self.scored_by.upper() + \") \" + \"─\" * 28 + \"┐\",\n            f\"  │  Headline clarity       {self.headline_clarity:>3}/20  {bar(self.headline_clarity,20)}  │\",\n            f\"  │  Visual impact          {self.visual_impact:>3}/20  {bar(self.visual_impact,20)}  │\",\n            f\"  │  Story importance       {self.story_importance:>3}/20  {bar(self.story_importance,20)}  │\",\n            f\"  │  Mobile readability     {self.mobile_readability:>3}/15  {bar(self.mobile_readability,15)}  │\",\n            f\"  │  Emotional interest     {self.emotional_interest:>3}/10  {bar(self.emotional_interest,10)}  │\",\n            f\"  │  Brand consistency      {self.brand_consistency:>3}/10  {bar(self.brand_consistency,10)}  │\",\n            f\"  │  Professional quality   {self.professional_quality:>3}/5   {bar(self.professional_quality,5)}   │\",\n            f\"  │  {'─' * 52}│\",\n            f\"  │  TOTAL  {self.total:>3}/100   VERDICT → {self.verdict:<24}│\",\n            \"  └\" + \"─\" * 54 + \"┘\",\n        ]\n        # Append per-criterion reasoning if present\n        if self.reasoning:\n            lines.append(\"  Reasoning:\")\n            labels = {\n                \"headline_clarity\":    \"Headline clarity   \",\n                \"visual_impact\":       \"Visual impact      \",\n                \"story_importance\":    \"Story importance   \",\n                \"mobile_readability\":  \"Mobile readability \",\n                \"emotional_interest\":  \"Emotional interest \",\n                \"brand_consistency\":   \"Brand consistency  \",\n                \"professional_quality\":\"Professional quality\",\n            }\n            for key, label in labels.items():\n                reason = self.reasoning.get(key, \"\")\n                if reason:\n                    lines.append(f\"    {label}: {reason[:90]}\")\n        return \"\\n\".join(lines)\n\n\n# ── Public interface ──────────────────────────────────────────────────────────\n\ndef score_attention(\n    story: Story,\n    image_path: Optional[Path] = None,\n    mobile_issues: Optional[dict] = None,\n) -> AttentionResult:\n    \"\"\"\n    Score the card and return an AttentionResult.\n    Writes result to score_log.jsonl regardless of outcome.\n    Falls back to heuristic if Ollama is unavailable.\n    \"\"\"\n    # Extract pixel-level card facts for visual context injection\n    card_facts = _extract_card_facts(image_path) if image_path else {}\n\n    prompt = _build_prompt(story, image_path, mobile_issues, card_facts)\n\n    try:\n        raw    = _call_ollama(prompt)\n        result = _parse_response(raw, story)\n        result.scored_by = \"llm\"\n    except Exception as exc:\n        logger.warning(\"Attention score LLM call failed (%s) — using heuristic fallback\", exc)\n        result = _heuristic_score(story, mobile_issues, card_facts)\n\n    logger.info(\"%s\", result.scorecard())\n    _write_score_log(story, result, image_path)\n    return result\n\n\n# ── Improvement 1: Visual context extraction ─────────────────────────────────\n\ndef _extract_card_facts(image_path: Path) -> dict:\n    \"\"\"\n    Extract concrete measurable facts from the composed card image.\n    These replace vague descriptions with real pixel evidence.\n    Returns a dict of human-readable fact strings.\n    \"\"\"\n    from PIL import Image as PILImage\n\n    facts: dict = {}\n    if not image_path or not image_path.exists():\n        return facts\n\n    try:\n        img = PILImage.open(image_path).convert(\"RGB\")\n        arr = np.array(img)\n        h, w = arr.shape[:2]\n\n        # ── Headline zone (top 28% of card, left 55%) ────────────────────────\n        hl_zone = arr[:int(h * 0.28), :int(w * 0.55)]\n        hl_mean = float(hl_zone.mean())\n        hl_dark = hl_mean < 80\n        facts[\"headline_bg\"] = (\n            f\"{'DARK' if hl_dark else 'BRIGHT'} background behind headline \"\n            f\"(mean brightness {hl_mean:.0f}/255). \"\n            f\"{'Good contrast for white text.' if hl_dark else 'Risk: white text hard to read.'}\"\n        )\n\n        # ── Impact word highlight detection ─────────────────────────────────\n        # A red highlight box = cluster of pixels where R >> G,B in headline zone\n        r, g, b = hl_zone[:,:,0], hl_zone[:,:,1], hl_zone[:,:,2]\n        red_mask = (r.astype(int) - g.astype(int) > 80) & (r > 150)\n        red_pct  = float(red_mask.sum()) / hl_zone.size * 3 * 100\n        facts[\"impact_highlight\"] = (\n            f\"Impact word red highlight {'DETECTED' if red_pct > 0.3 else 'NOT DETECTED'} \"\n            f\"({red_pct:.1f}% red pixels in headline zone). \"\n            f\"{'Adds urgency.' if red_pct > 0.3 else 'No visual emphasis on key word.'}\"\n        )\n\n        # ── Photo sharpness (Laplacian on center band) ────────────────────────\n        mid = arr[int(h*0.30):int(h*0.70), int(w*0.10):int(w*0.90)]\n        gray = mid.mean(axis=2).astype(np.float32)\n        lap  = (gray[1:-1,1:-1]*4 - gray[:-2,1:-1] - gray[2:,1:-1]\n                - gray[1:-1,:-2] - gray[1:-1,2:])\n        blur_score = float(lap.var())\n        if blur_score > 300:\n            sharpness = \"VERY SHARP\"\n        elif blur_score > 150:\n            sharpness = \"SHARP\"\n        elif blur_score > 80:\n            sharpness = \"ACCEPTABLE\"\n        elif blur_score > 30:\n            sharpness = \"SOFT\"\n        else:\n            sharpness = \"BLURRY\"\n        facts[\"photo_sharpness\"] = (\n            f\"Photo sharpness: {sharpness} (Laplacian var={blur_score:.0f}). \"\n            f\"{'Clean, professional photo.' if blur_score > 80 else 'Blurry photo weakens visual credibility.'}\"\n        )\n\n        # ── Footer darkness (brand zone) ─────────────────────────────────────\n        footer = arr[h-200:, :]\n        footer_brightness = float(footer.mean())\n        facts[\"footer_darkness\"] = (\n            f\"Footer zone mean brightness {footer_brightness:.0f}/255 — \"\n            f\"{'DARK (logo/source readable).' if footer_brightness < 80 else 'TOO BRIGHT: logo and source name may be invisible.'}\"\n        )\n\n        # ── Photo subject center visibility ──────────────────────────────────\n        center = arr[int(h*0.35):int(h*0.65), int(w*0.20):int(w*0.80)]\n        center_b = float(center.mean())\n        center_s = float(center.std())\n        facts[\"photo_center\"] = (\n            f\"Center of photo: mean={center_b:.0f}/255, texture={center_s:.0f}. \"\n            + (\n                \"Subject visible with texture — good.\" if center_b > 30 and center_s > 15\n                else \"Center appears dark or flat — subject may not be visible.\"\n            )\n        )\n\n        # ── Brand color presence (navy + red in card) ────────────────────────\n        # Sample top border (6px) — should be RED\n        top_border = arr[:6, :]\n        tb_r = float(top_border[:,:,0].mean())\n        tb_g = float(top_border[:,:,1].mean())\n        tb_b = float(top_border[:,:,2].mean())\n        is_red_border = tb_r > 150 and tb_g < 80 and tb_b < 80\n        facts[\"brand_colors\"] = (\n            f\"Top border color: R={tb_r:.0f} G={tb_g:.0f} B={tb_b:.0f} — \"\n            f\"{'RED border present ✓ brand consistent.' if is_red_border else 'Border color unexpected — possible brand issue.'}\"\n        )\n\n        # ── Overall photo brightness distribution ─────────────────────────────\n        # Categorise mid-photo zone into dark/mid/bright\n        photo_mid = arr[int(h*0.25):int(h*0.75), :]\n        brightness_vals = photo_mid.mean(axis=2).flatten()\n        dark_pct  = float((brightness_vals < 60).sum())  / len(brightness_vals) * 100\n        mid_pct   = float(((brightness_vals >= 60) & (brightness_vals < 180)).sum()) / len(brightness_vals) * 100\n        bright_pct= float((brightness_vals >= 180).sum()) / len(brightness_vals) * 100\n        facts[\"photo_distribution\"] = (\n            f\"Photo brightness: {dark_pct:.0f}% dark / {mid_pct:.0f}% midtone / {bright_pct:.0f}% bright. \"\n            + (\n                \"Well-exposed editorial photo.\" if mid_pct > 40\n                else \"Very dark or very bright photo — may reduce visual impact.\"\n            )\n        )\n\n    except Exception as exc:\n        logger.debug(\"Card fact extraction failed: %s\", exc)\n\n    return facts\n\n\n# ── Improvement 2: Chain-of-thought prompt ────────────────────────────────────\n\ndef _build_prompt(\n    story: Story,\n    image_path: Optional[Path],\n    mobile_issues: Optional[dict],\n    card_facts: dict,\n) -> str:\n    headline  = story.title\n    category  = (story.category or \"news\").upper()\n    source    = story.source_name or \"Unknown\"\n    summary   = (story.raw_summary or \"\")[:300]\n    has_image = image_path is not None and image_path.exists()\n    word_count = len(headline.split())\n\n    # Mobile issues section\n    if mobile_issues:\n        mobile_section = (\n            \"MOBILE CHECKS: The following automated pixel checks FAILED:\\n\"\n            + \"\\n\".join(f\"  ✗ {k}: {v}\" for k, v in mobile_issues.items())\n        )\n    else:\n        mobile_section = \"MOBILE CHECKS: All automated pixel checks PASSED ✓\"\n\n    # Visual card facts section (Improvement 1)\n    if card_facts:\n        facts_section = \"CARD PIXEL ANALYSIS (measured from the actual composed image):\\n\" + \\\n            \"\\n\".join(f\"  • {v}\" for v in card_facts.values())\n    else:\n        facts_section = \"CARD PIXEL ANALYSIS: No image available (text-only post).\"\n\n    no_image_penalty = \"\" if has_image else \"\\n⚠ No image — deduct 8–12 points from Visual Impact automatically.\"\n\n    return f\"\"\"You are a senior social media editor at \"Global Pulse News\", a professional Facebook news page.\n\nScore this Facebook news card BEFORE publishing. This is an INTERNAL quality gate.\nScore it as a real human thumb-scrolling their phone feed would experience it.\nBe HONEST. Do NOT inflate scores. A score of 20/20 means near-perfect execution.\n\n━━━ POST DETAILS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nHEADLINE   : {headline}\nWORD COUNT : {word_count} words\nCATEGORY   : {category}\nSOURCE     : {source}\nSUMMARY    : {summary}\nIMAGE      : {\"Composed card image exists\" if has_image else \"NO IMAGE — text-only post\"}{no_image_penalty}\n\n━━━ AUTOMATED CHECKS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n{mobile_section}\n\n━━━ VISUAL CARD DATA (real pixel measurements) ━━━━━━━━━━━\n{facts_section}\n\n━━━ SCORING INSTRUCTIONS ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFor EACH criterion below, you MUST:\n  Step 1 — State ONE specific observation about this post that justifies your score.\n  Step 2 — Give the numeric score.\n\nThis two-step process is required. Do not skip reasoning.\nUse the pixel data above as evidence — it reflects the actual card.\n\nCRITERIA:\n\n1. headline_clarity (0–20)\n   Is the headline sharp, specific, and instantly scannable?\n   20 = anyone reads it and knows exactly what happened.\n   Deduct for: vague subjects, missing actors, jargon, ambiguity.\n   Deduct 3+ if >10 words (too slow for phone scanning).\n\n2. visual_impact (0–20)\n   Would this card stop a thumb mid-scroll on a phone?\n   20 = visually striking photo, strong composition, compelling.\n   Use sharpness, brightness distribution, and highlight data above.\n   Deduct heavily for: blurry photo, flat composition, no image.\n\n3. story_importance (0–20)\n   Does this story matter to a broad general audience TODAY?\n   20 = millions of people worldwide need to know this right now.\n   Deduct for: niche topics, minor local news, low-stakes content.\n\n4. mobile_readability (0–15)\n   Can a phone user read and understand this in under 2 seconds?\n   15 = perfect — large headline, dark background, clear hierarchy.\n   Use the mobile check results and headline background data above.\n   Deduct for each failed mobile check.\n\n5. emotional_interest (0–10)\n   Does this post create curiosity, urgency, or emotional response?\n   10 = reader feels compelled to tap, comment, or share immediately.\n   Deduct for: dry factual reporting, no tension, no stakes expressed.\n\n6. brand_consistency (0–10)\n   Does this look unmistakably like Global Pulse News?\n   10 = navy+white+red palette, professional badge, source attribution, clean footer.\n   Use the brand color data above as evidence.\n   Deduct for anything generic, inconsistent, or off-brand.\n\n7. professional_quality (0–5)\n   Is the card clean, polished, and error-free?\n   5 = no visible layout issues, no overflow, no clutter.\n   Deduct for any layout errors detected in the pixel or mobile analysis.\n\n━━━ OUTPUT FORMAT ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nRespond ONLY with valid JSON. No markdown. No text outside the JSON.\n\n{{\n  \"reasoning\": {{\n    \"headline_clarity\":     \"<Step 1: one specific observation> → score: N\",\n    \"visual_impact\":        \"<Step 1: one specific observation> → score: N\",\n    \"story_importance\":     \"<Step 1: one specific observation> → score: N\",\n    \"mobile_readability\":   \"<Step 1: one specific observation> → score: N\",\n    \"emotional_interest\":   \"<Step 1: one specific observation> → score: N\",\n    \"brand_consistency\":    \"<Step 1: one specific observation> → score: N\",\n    \"professional_quality\": \"<Step 1: one specific observation> → score: N\"\n  }},\n  \"headline_clarity\":     <int 0-20>,\n  \"visual_impact\":        <int 0-20>,\n  \"story_importance\":     <int 0-20>,\n  \"mobile_readability\":   <int 0-15>,\n  \"emotional_interest\":   <int 0-10>,\n  \"brand_consistency\":    <int 0-10>,\n  \"professional_quality\": <int 0-5>,\n  \"notes\": \"<one-line overall summary of the card's main strength and weakness>\"\n}}\n\"\"\"\n\n\n# ── Ollama call ───────────────────────────────────────────────────────────────\n\ndef _call_ollama(prompt: str) -> str:\n    base_url = (config.OLLAMA_BASE_URL or \"http://localhost:11434/v1\").rstrip(\"/\")\n    model    = config.OLLAMA_MODEL or \"llama3.2\"\n\n    payload = {\n        \"model\":    model,\n        \"messages\": [{\"role\": \"user\", \"content\": prompt}],\n        \"stream\":   False,\n        \"options\":  {\n            \"temperature\": 0.15,  # very low — consistent evaluative scoring\n            \"top_p\":       0.9,\n            \"num_predict\": 800,   # enough for reasoning + scores\n        },\n    }\n\n    r = requests.post(f\"{base_url}/chat/completions\", json=payload, timeout=60)\n    r.raise_for_status()\n    return r.json()[\"choices\"][0][\"message\"][\"content\"].strip()\n\n\n# ── Response parser ───────────────────────────────────────────────────────────\n\ndef _parse_response(raw: str, story: Story) -> AttentionResult:\n    # Strip markdown fences, fix trailing commas\n    text = re.sub(r\"```(?:json)?\", \"\", raw).strip()\n    text = re.sub(r\",\\s*([}\\]])\", r\"\\1\", text)\n\n    match = re.search(r\"\\{.*\\}\", text, re.DOTALL)\n    if not match:\n        raise ValueError(f\"No JSON in LLM response: {raw[:200]}\")\n\n    data = json.loads(match.group())\n\n    def clamp(val, lo, hi):\n        try:\n            return max(lo, min(hi, int(val)))\n        except (TypeError, ValueError):\n            return lo\n\n    hc = clamp(data.get(\"headline_clarity\",     0), 0, 20)\n    vi = clamp(data.get(\"visual_impact\",         0), 0, 20)\n    si = clamp(data.get(\"story_importance\",      0), 0, 20)\n    mr = clamp(data.get(\"mobile_readability\",    0), 0, 15)\n    ei = clamp(data.get(\"emotional_interest\",    0), 0, 10)\n    bc = clamp(data.get(\"brand_consistency\",     0), 0, 10)\n    pq = clamp(data.get(\"professional_quality\",  0), 0,  5)\n\n    # Extract reasoning — strip the \" → score: N\" suffix for clean display\n    raw_reasoning = data.get(\"reasoning\", {})\n    reasoning = {}\n    for key, val in raw_reasoning.items():\n        # Remove trailing \"→ score: N\" if present\n        clean = re.sub(r\"\\s*→\\s*score:\\s*\\d+\\s*$\", \"\", str(val)).strip()\n        reasoning[key] = clean[:120]\n\n    notes = str(data.get(\"notes\", \"\"))[:200]\n    total = hc + vi + si + mr + ei + bc + pq\n\n    return AttentionResult(\n        headline_clarity     = hc,\n        visual_impact        = vi,\n        story_importance     = si,\n        mobile_readability   = mr,\n        emotional_interest   = ei,\n        brand_consistency    = bc,\n        professional_quality = pq,\n        total                = total,\n        verdict              = _verdict(total, story),\n        reasoning            = reasoning,\n        notes                = notes,\n        raw_response         = raw,\n        scored_by            = \"llm\",\n    )\n\n\n# ── Improvement 3: Score log ──────────────────────────────────────────────────\n\ndef _write_score_log(\n    story: Story,\n    result: AttentionResult,\n    image_path: Optional[Path],\n) -> None:\n    \"\"\"\n    Append one line to score_log.jsonl.\n    Each record contains story metadata + full scores for later correlation\n    with Facebook Insights (reach, engagement) in Phase 7.\n    \"\"\"\n    record = {\n        \"ts\":                  datetime.now(timezone.utc).isoformat(),\n        \"title\":               story.title,\n        \"category\":            story.category or \"news\",\n        \"source\":              story.source_name or \"\",\n        \"image_path\":          str(image_path) if image_path else None,\n        \"scored_by\":           result.scored_by,\n        \"headline_clarity\":    result.headline_clarity,\n        \"visual_impact\":       result.visual_impact,\n        \"story_importance\":    result.story_importance,\n        \"mobile_readability\":  result.mobile_readability,\n        \"emotional_interest\":  result.emotional_interest,\n        \"brand_consistency\":   result.brand_consistency,\n        \"professional_quality\":result.professional_quality,\n        \"total\":               result.total,\n        \"verdict\":             result.verdict,\n        \"notes\":               result.notes,\n        # Placeholder for future Facebook Insights data\n        \"fb_post_id\":          None,\n        \"fb_reach\":            None,\n        \"fb_engagement\":       None,\n    }\n    try:\n        with open(SCORE_LOG_PATH, \"a\", encoding=\"utf-8\") as f:\n            f.write(json.dumps(record, ensure_ascii=False) + \"\\n\")\n    except Exception as exc:\n        logger.warning(\"Could not write score log: %s\", exc)\n\n\n# ── Heuristic fallback ────────────────────────────────────────────────────────\n\ndef _heuristic_score(\n    story: Story,\n    mobile_issues: Optional[dict],\n    card_facts: Optional[dict] = None,\n) -> AttentionResult:\n    \"\"\"\n    Rule-based fallback when Ollama is unavailable.\n    Uses card pixel facts where available for more accurate scores.\n    Conservative — never inflates beyond what evidence supports.\n    \"\"\"\n    headline     = story.title or \"\"\n    words        = len(headline.split())\n    category     = (story.category or \"news\").lower()\n    issue_count  = len(mobile_issues) if mobile_issues else 0\n    facts        = card_facts or {}\n\n    # Headline clarity\n    hc = 16 if words <= 6 else 14 if words <= 10 else 11 if words <= 14 else 8\n\n    # Visual impact — use sharpness fact if available\n    vi = 15\n    if \"photo_sharpness\" in facts:\n        if \"VERY SHARP\" in facts[\"photo_sharpness\"]:  vi = 18\n        elif \"SHARP\"     in facts[\"photo_sharpness\"]:  vi = 16\n        elif \"SOFT\"      in facts[\"photo_sharpness\"]:  vi = 10\n        elif \"BLURRY\"    in facts[\"photo_sharpness\"]:  vi = 6\n    vi = max(6, vi - issue_count * 2)\n\n    # Story importance\n    high_impact = {\"breaking\", \"war\", \"politics\", \"crime\", \"world\"}\n    si = 16 if category in high_impact else 12\n\n    # Mobile readability — use headline_bg fact if available\n    mr = 13\n    if \"headline_bg\" in facts and \"TOO BRIGHT\" in facts[\"headline_bg\"]:\n        mr -= 4\n    mr = max(5, mr - issue_count * 2)\n\n    # Emotional interest\n    emotional = {\"breaking\", \"war\", \"crime\", \"trending\", \"entertainment\"}\n    ei = 7 if category in emotional else 5\n\n    # Brand consistency — use brand_colors fact if available\n    bc = 7\n    if \"brand_colors\" in facts:\n        bc = 9 if \"brand consistent\" in facts[\"brand_colors\"] else 5\n\n    # Professional quality\n    pq = max(2, 5 - issue_count)\n\n    total   = hc + vi + si + mr + ei + bc + pq\n    verdict = _verdict(total, story)\n\n    reasoning = {\n        \"headline_clarity\":    f\"{words} words — {'concise' if words <= 10 else 'long for mobile'}\",\n        \"visual_impact\":       facts.get(\"photo_sharpness\", \"No image data available\"),\n        \"story_importance\":    f\"Category {category} — {'high-impact' if category in high_impact else 'moderate-impact'}\",\n        \"mobile_readability\":  facts.get(\"headline_bg\", f\"{issue_count} mobile check failure(s)\"),\n        \"emotional_interest\":  f\"Category {category} — {'emotionally engaging' if category in emotional else 'informational'}\",\n        \"brand_consistency\":   facts.get(\"brand_colors\", \"Brand data unavailable\"),\n        \"professional_quality\":f\"{issue_count} mobile check failure(s) detected\",\n    }\n\n    logger.info(\"Attention score (heuristic fallback): %d/100 → %s\", total, verdict)\n    return AttentionResult(\n        headline_clarity     = hc,\n        visual_impact        = vi,\n        story_importance     = si,\n        mobile_readability   = mr,\n        emotional_interest   = ei,\n        brand_consistency    = bc,\n        professional_quality = pq,\n        total                = total,\n        verdict              = verdict,\n        reasoning            = reasoning,\n        notes                = \"Heuristic fallback — Ollama unavailable.\",\n        raw_response         = \"\",\n        scored_by            = \"heuristic\",\n    )\n\n\n# ── Verdict helper ────────────────────────────────────────────────────────────\n\ndef _verdict(total: int, story: Story) -> str:\n    category = (story.category or \"news\").lower()\n    tier     = getattr(story, \"tier\", None)\n    is_high  = (\n        category in {\"breaking\", \"war\", \"politics\", \"world\", \"crime\"}\n        or str(tier) in {\"1\", \"EditorialTier.TIER1\", \"Tier1\"}\n    )\n\n    if total >= THRESHOLD_PUBLISH:\n        return \"PUBLISH\"\n    elif total >= THRESHOLD_PUBLISH_IF_HIGH:\n        return \"PUBLISH\" if is_high else \"PUBLISH_IF_HIGH\"\n    elif total >= THRESHOLD_IMPROVE:\n        return \"IMPROVE\"\n    else:\n        return \"REGENERATE\"\n"
              }
            }
